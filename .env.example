# ==============================================================================
# Aplikasi: Asisten Virtual Bahrul Maghfiroh (Standalone Laravel + RAG)
# ==============================================================================

APP_NAME="Asisten Virtual Bahrul Maghfiroh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database (Default Produksi & Laragon: MySQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bm_chatbot
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Session, Cache & Queue
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true saat deploy menggunakan HTTPS
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# AI Provider Configuration (Default: Google Gemini API)
# ------------------------------------------------------------------------------
# Pilihan LLM Driver: gemini | openai_compatible
AI_LLM_DRIVER=gemini
AI_LLM_MODEL=gemini-2.5-flash
AI_LLM_TEMPERATURE=0.2
AI_LLM_MAX_TOKENS=1024

# Pilihan Embedding Driver: gemini | openai_compatible
AI_EMBEDDING_DRIVER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
# Dimensi tunggal untuk API Embedding (outputDimensionality) dan Vector Collection Qdrant
AI_EMBEDDING_DIMENSIONS=768

# Retry saat kegagalan sementara provider AI
AI_RETRY_TIMES=2
AI_RETRY_SLEEP_MS=500

# Google Gemini API Key (Simpan hanya di server .env, jangan pernah di frontend)
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Adapter OpenAI-Compatible (Opsional jika mengganti provider AI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# Vector Storage Configuration (Default: Qdrant | Alternatif: mysql)
# ------------------------------------------------------------------------------
AI_VECTOR_DRIVER=qdrant
AI_VECTOR_FALLBACK_DRIVER=mysql
QDRANT_HOST=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bm_knowledge_chunks
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=10

# Parameter Retrieval RAG
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# Integrasi SIB-BM (Sistem Informasi Bangunan Bahrul Maghfiroh)
# ------------------------------------------------------------------------------
SIBBM_API_ENABLED=false
SIBBM_API_BASE_URL=
SIBBM_API_BUILDINGS_ENDPOINT=/buildings
SIBBM_API_KEY=
SIBBM_API_TIMEOUT=5
SIBBM_CACHE_TTL=3600
SIBBM_LOCAL_JSON_PATH=

# ------------------------------------------------------------------------------
# Keamanan Widget & CORS Website Utama
# ------------------------------------------------------------------------------
ALLOWED_WIDGET_ORIGINS=https://bahrulmaghfirohmalang.or.id,https://www.bahrulmaghfirohmalang.or.id
CHAT_RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------------------------
# Seeder Admin Awal
# ------------------------------------------------------------------------------
# WAJIB diisi kata sandi kuat (min. 12 karakter) sebelum menjalankan db:seed di produksi.
# Jika dikosongkan pada mode local, seeder akan membuat kata sandi acak dan menampilkannya sekali di terminal.
ADMIN_SEED_NAME="Administrator Pondok"
ADMIN_SEED_EMAIL=admin@bahrulmaghfirohmalang.or.id
ADMIN_SEED_PASSWORD=
